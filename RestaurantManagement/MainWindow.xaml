<Window x:Class="RestaurantManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantManagement"
        xmlns:views="clr-namespace:RestaurantManagement.Views"
        xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels"
        xmlns:converters="clr-namespace:RestaurantManagement.Converters"
        mc:Ignorable="d"
        Title="Restaurant Management" Height="700" Width="1250" 
        WindowStartupLocation="CenterScreen"
        MinWidth="1150" MinHeight="600">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" 
                Background="#2C3E50" 
                BorderBrush="#1A2530" 
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Restaurant Logo/Name -->
                <Border DockPanel.Dock="Top" 
                        Background="#1A2530" 
                        Padding="15">
                    <TextBlock Text="Restaurant Management" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               TextWrapping="Wrap"/>
                </Border>
                
                <!-- Navigation Menu -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="MenuButton" 
                            Content="Meniu Restaurant" 
                            Foreground="White" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="15" 
                            HorizontalContentAlignment="Left" 
                            FontSize="14" 
                            Click="MenuButton_Click"/>
                    
                    <!-- Shopping Cart Button -->
                    <Button x:Name="CartButton" 
                            Content="Coș de cumpărături" 
                            Foreground="White" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="15" 
                            HorizontalContentAlignment="Left" 
                            FontSize="14"
                            Click="CartButton_Click"/>
                    
                    <!-- Customer Orders Button -->
                    <Button x:Name="OrdersButton" 
                            Content="Comenzile mele" 
                            Foreground="White" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="15" 
                            HorizontalContentAlignment="Left" 
                            FontSize="14"
                            Click="OrdersButton_Click"/>
                    
                    <!-- Employee Menu Button - only visible for employees -->
                    <Button x:Name="EmployeeMenuButton" 
                            Content="Administrare Restaurant" 
                            Foreground="White" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="15" 
                            HorizontalContentAlignment="Left" 
                            FontSize="14"
                            Click="EmployeeMenuButton_Click"
                            Visibility="Collapsed"/>
                    
                    <!-- More navigation items can be added here -->
                </StackPanel>
                
                <!-- User Info at Bottom -->
                <Border DockPanel.Dock="Bottom" 
                        Background="#1A2530" 
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" 
                                   Foreground="White" 
                                   FontWeight="SemiBold"/>
                        <Button Content="Deconectare" 
                                Background="Transparent" 
                                Foreground="#81C784" 
                                BorderThickness="0" 
                                Padding="0" 
                                Margin="0,5,0,0" 
                                HorizontalAlignment="Left"
                                Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <!-- Content Frame for navigation -->
            <Frame x:Name="ContentFrame" 
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
