<Window x:Class="RestaurantManagement.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantManagement.Views"
        xmlns:converters="clr-namespace:RestaurantManagement.Converters"
        mc:Ignorable="d"
        Title="Restaurant Management - Login" Height="600" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="20" 
            CornerRadius="8" Background="White">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Restaurant Management" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Register" 
                           Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="16" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Login" 
                           Visibility="{Binding IsRegistering, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                           FontSize="16" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error Message -->
            <TextBlock Grid.Row="1" 
                       Foreground="Red" 
                       Text="{Binding ErrorMessage}" 
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <!-- Login Form -->
            <StackPanel Grid.Row="2" 
                        Visibility="{Binding IsRegistering, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="Email"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                
                <TextBlock Text="Password"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>
                
                <Button Command="{Binding LoginCommand}" 
                        Content="Login"/>
                
                <Button Command="{Binding SwitchToRegisterCommand}" 
                        Content="Register New Account" 
                        Background="#2196F3"/>
                
                <Button Command="{Binding GuestLoginCommand}" 
                        Content="Continue as Guest" 
                        Background="#9E9E9E" 
                        Margin="0,20,0,0"/>
            </StackPanel>

            <!-- Register Form -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="First Name"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="Last Name"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="Phone Number"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="Delivery Address"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="Password"/>
                    <PasswordBox x:Name="RegisterPasswordBox"/>
                    
                    <TextBlock Text="Confirm Password"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,20"/>
                    
                    <Button Command="{Binding RegisterCommand}" 
                            Content="Create Account"/>
                    
                    <Button Command="{Binding SwitchToLoginCommand}" 
                            Content="Back to Login" 
                            Background="#2196F3"/>
                </StackPanel>
            </ScrollViewer>
            
            <TextBlock Grid.Row="3" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Bottom" 
                       Text="© 2023 Restaurant Management System" 
                       Foreground="#757575"/>
        </Grid>
    </Border>
</Window> 