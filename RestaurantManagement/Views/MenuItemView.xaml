<UserControl x:Class="RestaurantManagement.Views.MenuItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views"
             xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels"
             xmlns:converters="clr-namespace:RestaurantManagement.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:MenuItemViewModel}"
             mc:Ignorable="d">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Border BorderBrush="#DDDDDD" 
            BorderThickness="1" 
            CornerRadius="5" 
            Padding="15" 
            Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Image Gallery -->
            <Border Grid.Column="0" 
                    Width="120" 
                    Height="120" 
                    Margin="0,0,15,0" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="1" 
                    Background="#F5F5F5">
                <ItemsControl ItemsSource="{Binding Images}" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" 
                                   Width="110" 
                                   Height="110" 
                                   Stretch="Uniform"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Item Details -->
            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                <TextBlock Text="{Binding Name}" 
                           FontSize="16" 
                           FontWeight="SemiBold"/>
                
                <TextBlock Text="{Binding CategoryName}" 
                           Foreground="#666666" 
                           Margin="0,3,0,5"/>
                
                <TextBlock Text="{Binding Description}" 
                           TextWrapping="Wrap" 
                           Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal" 
                            Margin="0,0,0,5">
                    <TextBlock Text="Porție: " 
                               FontWeight="SemiBold"/>
                    
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="PortionSize"/>
                                <Binding Path="PortionUnit"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                
                <TextBlock Text="{Binding AllergensList}" 
                           FontStyle="Italic" 
                           TextWrapping="Wrap" 
                           Foreground="#555555"/>
            </StackPanel>

            <!-- Price and Availability -->
            <StackPanel Grid.Column="2" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Price, StringFormat={}{0:N2} lei}" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Right"/>
                
                <TextBlock Text="INDISPONIBIL" 
                           Foreground="Red" 
                           FontWeight="Bold" 
                           Margin="0,10,0,0" 
                           Visibility="{Binding IsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                
                <!-- Button for authenticated users -->
                <Button x:Name="AddToCartButton"
                        Content="Adaugă în coș"
                        Padding="10,5"
                        Margin="0,10,0,0"
                        Click="AddToCart_Click"
                        Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Tag="LoggedIn"/>
                        
                <!-- Button for guest users -->
                <Button x:Name="LoginButton"
                        Content="Autentificare pentru comandă"
                        Padding="10,5"
                        Margin="0,10,0,0"
                        Click="LoginButton_Click"
                        Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Tag="Guest"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl> 