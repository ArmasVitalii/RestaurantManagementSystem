<UserControl x:Class="RestaurantManagement.Views.PopularDishesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views"
             xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PopularDishesViewModel}"
             mc:Ignorable="d">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="20">
            <TextBlock Text="Raport Preparate Populare" FontSize="24" FontWeight="SemiBold" />
        </Border>
        
        <!-- Filter Controls -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Din:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Margin="0,0,20,0"/>
            
            <TextBlock Grid.Column="2" Text="Până la:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Margin="0,0,20,0"/>
            
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Top:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox SelectedValue="{Binding TopCount}" Width="60">
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="50"/>
                </ComboBox>
            </StackPanel>
            
            <Button Grid.Column="5" Content="Generează Raport" Command="{Binding LoadReportCommand}" 
                    Padding="10,5"/>
        </Grid>
        
        <!-- Content Area -->
        <Grid Grid.Row="2" Margin="20">
            <!-- No Data Message -->
            <Border Background="#F8F9FA" BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" 
                    Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Nu există date disponibile pentru perioada selectată."
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                               HorizontalAlignment="Center" Foreground="Red" />
                </StackPanel>
            </Border>
            
            <!-- Data Display -->
            <ListView ItemsSource="{Binding PopularDishes}" 
                      Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nume" DisplayMemberBinding="{Binding Name}" Width="150"/>
                        <GridViewColumn Header="Categorie" DisplayMemberBinding="{Binding Category}" Width="100"/>
                        <GridViewColumn Header="Preț" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} lei}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Total Comandat" DisplayMemberBinding="{Binding TotalOrdered}" Width="100"/>
                        <GridViewColumn Header="Nr. Comenzi" DisplayMemberBinding="{Binding OrderCount}" Width="100"/>
                        <GridViewColumn Header="Venit Total" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N2} lei}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Disponibilitate" DisplayMemberBinding="{Binding Availability}" Width="100"/>
                        <GridViewColumn Header="Alergeni" DisplayMemberBinding="{Binding Allergens}" Width="200"/>
                    </GridView>
                </ListView.View>
            </ListView>
            
            <!-- Loading Indicator -->
            <Grid Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Se încarcă datele..." FontSize="16" Margin="0,0,0,10"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="10"/>
                </StackPanel>
            </Grid>
        </Grid>
        
        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10">
            <Button Content="Exportă Raport" Command="{Binding ExportReportCommand}" Padding="10,5"
                    IsEnabled="{Binding HasData}"/>
        </StackPanel>
    </Grid>
</UserControl> 