<UserControl x:Class="RestaurantManagement.Views.ShoppingCartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RestaurantManagement.Views"
             xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels"
             xmlns:converters="clr-namespace:RestaurantManagement.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ShoppingCartViewModel}"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Coș de cumpărături" FontSize="24" FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Content="Continuă cumpărăturile"
                        Click="ContinueShopping_Click"
                        Padding="15,8" />
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Empty Cart -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="20">
                    <TextBlock Text="Coșul dvs. este gol" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <TextBlock Text="Adăugați produse din meniu în coșul dvs. pentru a plasa o comandă."
                               TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <Button Content="Vezi meniul restaurantului" 
                           Click="ContinueShopping_Click"
                           HorizontalAlignment="Center" Margin="0,20,0,0" Padding="15,10" />
                </StackPanel>

                <!-- Order Placed Success -->
                <StackPanel Visibility="{Binding IsOrderPlaced, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="20">
                    <Border Background="#E6F7E6" BorderBrush="#4CAF50" BorderThickness="1"
                            Padding="20" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Comandă plasată cu succes!" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,0,0,15" />
                            <TextBlock Text="{Binding SuccessMessage}"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,20" />
                            <Button Content="Continuă cumpărăturile" 
                                    Click="ContinueShopping_Click"
                                    HorizontalAlignment="Center" Padding="15,10" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cart with Items -->
                <Grid Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="20" IsEnabled="{Binding IsOrderPlaced, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Produs" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="Preț" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="Cantitate" FontWeight="Bold" />
                        <TextBlock Grid.Column="3" Text="Total" FontWeight="Bold" TextAlignment="Right" />
                    </Grid>

                    <!-- Error Messages -->
                    <Border Grid.Row="0" Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1"
                            Padding="15" CornerRadius="5" Margin="0,0,0,15">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Cart Items -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CartItems}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Item Details -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CategoryName}" Foreground="#666666" />
                                        </StackPanel>

                                        <!-- Price -->
                                        <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N2} lei}" />

                                        <!-- Quantity -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="-" Width="25" Click="DecreaseQuantity_Click" Tag="{Binding}" />
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="30" TextAlignment="Center" Margin="5,0" />
                                            <Button Content="+" Width="25" Click="IncreaseQuantity_Click" Tag="{Binding}" />
                                        </StackPanel>

                                        <!-- Total -->
                                        <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat={}{0:N2} lei}" TextAlignment="Right" />

                                        <!-- Remove button -->
                                        <Button Grid.Column="4" Content="×" FontSize="16" FontWeight="Bold"
                                                Width="30" Height="30" Padding="0" Background="Transparent"
                                                BorderThickness="0" Foreground="#E53935"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Order Summary -->
                    <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,20,0,0"
                            Background="#F9F9F9" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Subtotal -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat={}{0:N2} lei}" />

                            <!-- Discount -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Visibility="{Binding IsDiscountEligible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Discount:" Foreground="#4CAF50" />
                                    <TextBlock Grid.Column="1" Text="{Binding DiscountValue, StringFormat={}{0:N2} lei}" Foreground="#4CAF50" />
                                </Grid>
                                <TextBlock Text="{Binding DiscountPercentage, StringFormat={}(Reducere {0}%)}"
                                           Foreground="#4CAF50" FontSize="12" Margin="0,0,0,5" />
                            </StackPanel>

                            <!-- Delivery -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Livrare:" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeliveryCost, StringFormat={}{0:N2} lei}" Margin="0,5,0,0" />

                            <!-- Separator -->
                            <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10" />

                            <!-- Total -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Total:" FontWeight="Bold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Total, StringFormat={}{0:N2} lei}" FontWeight="Bold" />

                            <!-- Order Button -->
                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,15,0,0"
                                        HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Content="Golește coșul" Command="{Binding ClearCartCommand}"
                                        Padding="15,10" Margin="0,0,10,0" Background="Transparent" Foreground="#D32F2F" BorderBrush="#D32F2F" />
                                <Button Content="Plasează comanda" Command="{Binding PlaceOrderCommand}"
                                        Padding="15,10" Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="False">
                                                    <Setter Property="Content" Value="Autentificare pentru comandă" />
                                                    <Setter Property="Command" Value="{Binding LoginCommand}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Loading Overlay -->
                    <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80FFFFFF"
                          Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Se procesează comanda..." FontSize="16" Margin="0,0,0,10" />
                            <ProgressBar IsIndeterminate="True" Width="200" Height="10" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl> 